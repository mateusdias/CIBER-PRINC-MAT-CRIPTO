{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: compilar arquivo atual",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C: compilar e rodar arquivo atual",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "C: compilar arquivo atual",
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
